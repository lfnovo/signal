{
  "manifest_version": 3,
  "name": "Signal — Save a find",
  "version": "0.1.0",
  "description": "Give the current page a home in your local Signal inbox.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "action": {"default_title": "Save to Signal", "default_popup": "popup.html"},
  "options_page": "options.html"
}
