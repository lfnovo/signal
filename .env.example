# Copy to .env and supply your own provider key. Never commit .env.
GEMINI_API_KEY=

SIGNAL_DB_URL=ws://127.0.0.1:8019/rpc
SIGNAL_DB_NAMESPACE=signal
SIGNAL_DB_DATABASE=signal
SIGNAL_DB_USER=root
SIGNAL_DB_PASSWORD=root
SIGNAL_API_URL=http://127.0.0.1:8020

# For a hosted instance, use the public HTTPS origin above and set one password.
# It protects the web app and approves per-client OAuth access to the MCP server.
# SIGNAL_PASSWORD=use-a-long-random-password
# SIGNAL_HOST=0.0.0.0
# SIGNAL_ALLOWED_HOSTS=signal.example.com

# Initial defaults. Preferences saved in the UI override these values.
SIGNAL_LLM_PROVIDER=google
SIGNAL_LLM_MODEL=gemini-2.5-flash
SIGNAL_EMBEDDING_PROVIDER=google
SIGNAL_EMBEDDING_MODEL=gemini-embedding-001
SIGNAL_SUMMARY_LANGUAGE=Português
SIGNAL_URL_ENGINE=simple
SIGNAL_DOCUMENT_ENGINE=simple
SIGNAL_STT_PROVIDER=google
SIGNAL_STT_MODEL=gemini-2.5-flash

# Optional: absolute path shared by CLI and server. Defaults to <project>/.signal.
# SIGNAL_DATA_DIR=/absolute/path/to/signal-data
# Optional: location of your .env when installed outside the checkout.
# SIGNAL_HOME=/absolute/path/to/signal
