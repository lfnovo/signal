DEFINE TABLE IF NOT EXISTS source SCHEMALESS;
DEFINE INDEX IF NOT EXISTS source_fingerprint ON source FIELDS fingerprint UNIQUE;
DEFINE INDEX IF NOT EXISTS source_status ON source FIELDS status, created_at;
DEFINE TABLE IF NOT EXISTS conversation SCHEMALESS;
DEFINE FIELD IF NOT EXISTS source ON conversation TYPE record<source>;
DEFINE INDEX IF NOT EXISTS conversation_source ON conversation FIELDS source, created_at;
DEFINE TABLE IF NOT EXISTS setting SCHEMALESS;
DEFINE TABLE IF NOT EXISTS topic SCHEMALESS;
DEFINE INDEX IF NOT EXISTS topic_name ON topic FIELDS normalized UNIQUE;
DEFINE TABLE IF NOT EXISTS source_topic SCHEMALESS;
DEFINE FIELD IF NOT EXISTS source ON source_topic TYPE record<source>;
DEFINE FIELD IF NOT EXISTS topic ON source_topic TYPE record<topic>;
DEFINE INDEX IF NOT EXISTS source_topic_pair ON source_topic FIELDS source, topic UNIQUE;
DEFINE INDEX IF NOT EXISTS source_topic_topic ON source_topic FIELDS topic;
DEFINE INDEX IF NOT EXISTS source_collection ON source FIELDS collection, created_at;
DEFINE TABLE IF NOT EXISTS auth_client SCHEMALESS;
DEFINE TABLE IF NOT EXISTS auth_code SCHEMALESS;
DEFINE TABLE IF NOT EXISTS auth_token SCHEMALESS;
DEFINE INDEX IF NOT EXISTS auth_token_pair ON auth_token FIELDS pair_id;
DEFINE TABLE IF NOT EXISTS auth_pending SCHEMALESS;
DEFINE TABLE IF NOT EXISTS capture_token SCHEMALESS;
